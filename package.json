{
  "name": "wimui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React component library with design tokens, dark mode, i18n (en/ja/pt-BR), and WAI-ARIA compliant accessibility. 190+ components documented in Storybook.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./layout": {
      "types": "./dist/src/layout.d.ts",
      "import": "./dist/layout.js",
      "require": "./dist/layout.cjs"
    },
    "./form": {
      "types": "./dist/src/form.d.ts",
      "import": "./dist/form.js",
      "require": "./dist/form.cjs"
    },
    "./feedback": {
      "types": "./dist/src/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.cjs"
    },
    "./navigation": {
      "types": "./dist/src/navigation.d.ts",
      "import": "./dist/navigation.js",
      "require": "./dist/navigation.cjs"
    },
    "./data-display": {
      "types": "./dist/src/data-display.d.ts",
      "import": "./dist/data-display.js",
      "require": "./dist/data-display.cjs"
    },
    "./overlay": {
      "types": "./dist/src/overlay.d.ts",
      "import": "./dist/overlay.js",
      "require": "./dist/overlay.cjs"
    },
    "./typography": {
      "types": "./dist/src/typography.d.ts",
      "import": "./dist/typography.js",
      "require": "./dist/typography.cjs"
    },
    "./media": {
      "types": "./dist/src/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./charts": {
      "types": "./dist/src/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./ai": {
      "types": "./dist/src/ai.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    },
    "./tokens": {
      "types": "./dist/src/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    }
  },
  "size-limit": [
    {
      "name": "ESM library total (gzip)",
      "path": [
        "dist/src/**/*.js",
        "dist/_virtual/**/*.js",
        "dist/node_modules/**/*.js"
      ],
      "gzip": true,
      "limit": "340 kB"
    },
    {
      "name": "Bundled third-party code (gzip)",
      "path": "dist/node_modules/**/*.js",
      "gzip": true,
      "limit": "35 kB"
    },
    {
      "name": "form components (gzip)",
      "path": "dist/src/components/form/**/*.js",
      "gzip": true,
      "limit": "85 kB"
    },
    {
      "name": "charts components (gzip)",
      "path": "dist/src/components/charts/**/*.js",
      "gzip": true,
      "limit": "15 kB"
    },
    {
      "name": "UMD Bundle (gzip)",
      "path": "dist/wimui.umd.js",
      "gzip": true,
      "limit": "160 kB"
    }
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run generate:icons && vite",
    "build": "npm run generate:icons && vite build && vite build --mode umd && node scripts/fix-cjs-empty-css.js",
    "generate:icons": "node scripts/generate-icons.js",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:check": "node scripts/generate-missing-tests-report.cjs",
    "test:report": "npm run test:coverage && npm run test:check",
    "prestorybook": "npx kill-port 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "node scripts/cleanup-storybook.cjs && storybook build",
    "format": "prettier --write .",
    "lint": "eslint src stories --max-warnings=0",
    "lint:fix": "eslint src stories --fix --max-warnings=0",
    "stylelint:css": "stylelint \"{src,stories}/**/*.css\" --allow-empty-input",
    "stylelint:scss": "stylelint \"{src,stories}/**/*.scss\"",
    "stylelint": "npm run stylelint:css && npm run stylelint:scss",
    "stylelint:fix": "stylelint \"{src,stories}/**/*.{css,scss}\" --fix --allow-empty-input",
    "test:vrt": "playwright test",
    "test:vrt:update": "playwright test --update-snapshots",
    "test:vrt:report": "playwright show-report",
    "i18n:sync": "node scripts/sync-i18n.js",
    "i18n:check": "node scripts/check-i18n.js",
    "i18n:check:components": "node scripts/check-i18n-components.js",
    "i18n:missing": "node scripts/find_missing_keys.js",
    "i18n:check:mdx": "node scripts/check-mdx-hardcoded.js",
    "check:consistency": "node scripts/check_consistency.js",
    "check:hierarchy": "node scripts/check_hierarchy.js",
    "check:stories": "node scripts/check_stories_keys.js",
    "check:casing": "node scripts/check-git-casing.cjs",
    "check:links": "node scripts/check-mdx-links.js",
    "check:aschild": "node scripts/check-aschild.js",
    "audit-mdx": "node scripts/audit-mdx.js",
    "audit:all": "node scripts/audit-all.js",
    "scaffold": "node scripts/scaffold-component.js",
    "tokens:build": "node style-dictionary.config.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takeshisakuma/wimui.git"
  },
  "author": "takeshi sakuma",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/takeshisakuma/wimui/issues"
  },
  "homepage": "https://takeshisakuma.github.io/wimui/",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@changesets/cli": "2.31.0",
    "@eslint/js": "9.39.4",
    "@fullcalendar/core": "6.1.20",
    "@fullcalendar/daygrid": "6.1.20",
    "@fullcalendar/interaction": "6.1.20",
    "@fullcalendar/react": "6.1.20",
    "@fullcalendar/timegrid": "6.1.20",
    "@google/genai": "2.8.0",
    "@playwright/test": "^1.59.0",
    "@size-limit/file": "^12.0.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-mcp": "0.6.0",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/eslint-config-storybook": "^4.0.0",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "7.0.2",
    "@types/node": "^25.5.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "@xyflow/react": "12.11.0",
    "diff": "9.0.0",
    "dotenv": "^17.3.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.4.2",
    "gh-pages": "^6.3.0",
    "globals": "17.6.0",
    "husky": "^9.1.7",
    "i18next": "26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "3.0.6",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^12.0.0",
    "imagemin-webp": "^8.0.0",
    "jsdom": "^29.0.1",
    "lint-staged": "17.0.7",
    "playwright": "^1.59.0",
    "prettier": "^3.8.1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react-i18next": "17.0.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.98.0",
    "size-limit": "^12.0.1",
    "storybook": "^10.3.6",
    "storybook-react-i18next": "^10.1.1",
    "style-dictionary": "5.4.3",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.0.0",
    "typescript": "6.0.3",
    "vite-plugin-dts": "5.0.2",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@fullcalendar/core": ">=6.0.0",
    "@fullcalendar/daygrid": ">=6.0.0",
    "@fullcalendar/interaction": ">=6.0.0",
    "@fullcalendar/react": ">=6.0.0",
    "@fullcalendar/timegrid": ">=6.0.0",
    "@xyflow/react": ">=12.0.0",
    "diff": ">=9.0.0",
    "i18next": ">=23.0.0",
    "qrcode.react": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=14.0.0",
    "react-markdown": ">=10.0.0",
    "recharts": ">=3.0.0",
    "remark-gfm": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "diff": {
      "optional": true
    },
    "qrcode.react": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "@fullcalendar/core": {
      "optional": true
    },
    "@fullcalendar/daygrid": {
      "optional": true
    },
    "@fullcalendar/interaction": {
      "optional": true
    },
    "@fullcalendar/react": {
      "optional": true
    },
    "@fullcalendar/timegrid": {
      "optional": true
    }
  },
  "lint-staged": {
    "{src,stories}/**/*.{ts,tsx}": [
      "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0 --cache",
      "node scripts/check-i18n-components.js",
      "node scripts/check-git-casing.cjs"
    ],
    "{src,stories}/**/*.{css,scss}": [
      "stylelint --fix --max-warnings=0 --cache"
    ],
    "**/*.mdx": [
      "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0 --cache",
      "node scripts/check-mdx-hardcoded.js",
      "node scripts/check-i18n-components.js",
      "node scripts/check-mdx-links.js",
      "node scripts/audit-mdx.js"
    ],
    "public/locales/**/*.json": [
      "node scripts/check-i18n.js"
    ],
    "src/icon/*.svg": [
      "npm run generate:icons",
      "git add src/icon/index.ts"
    ]
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@radix-ui/react-slot": "1.2.4",
    "classnames": "^2.5.1",
    "music-metadata": "^11.12.3",
    "react-is": "19.2.7"
  }
}
