{
  "name": "wimui",
  "version": "0.19.0",
  "type": "module",
  "description": "React component library with design tokens, dark mode, i18n (en/ja/pt-BR), and WAI-ARIA compliant accessibility. 200+ components documented in Storybook.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/icons.ts",
    "./dist/icons.js",
    "./dist/icons.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "require": "./dist/layout.cjs"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js",
      "require": "./dist/form.cjs"
    },
    "./rhf": {
      "types": "./dist/rhf.d.ts",
      "import": "./dist/rhf.js",
      "require": "./dist/rhf.cjs"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.cjs"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js",
      "require": "./dist/navigation.cjs"
    },
    "./data-display": {
      "types": "./dist/data-display.d.ts",
      "import": "./dist/data-display.js",
      "require": "./dist/data-display.cjs"
    },
    "./data-display/markdown": {
      "types": "./dist/data-display/markdown.d.ts",
      "import": "./dist/data-display/markdown.js",
      "require": "./dist/data-display/markdown.cjs"
    },
    "./data-display/qr-code": {
      "types": "./dist/data-display/qr-code.d.ts",
      "import": "./dist/data-display/qr-code.js",
      "require": "./dist/data-display/qr-code.cjs"
    },
    "./data-display/node-graph": {
      "types": "./dist/data-display/node-graph.d.ts",
      "import": "./dist/data-display/node-graph.js",
      "require": "./dist/data-display/node-graph.cjs"
    },
    "./data-display/schedule-view": {
      "types": "./dist/data-display/schedule-view.d.ts",
      "import": "./dist/data-display/schedule-view.js",
      "require": "./dist/data-display/schedule-view.cjs"
    },
    "./data-display/json-diff-viewer": {
      "types": "./dist/data-display/json-diff-viewer.d.ts",
      "import": "./dist/data-display/json-diff-viewer.js",
      "require": "./dist/data-display/json-diff-viewer.cjs"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js",
      "require": "./dist/overlay.cjs"
    },
    "./typography": {
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js",
      "require": "./dist/typography.cjs"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    },
    "./ai/streaming-text": {
      "types": "./dist/ai/streaming-text.d.ts",
      "import": "./dist/ai/streaming-text.js",
      "require": "./dist/ai/streaming-text.cjs"
    },
    "./ai/markdown-renderer": {
      "types": "./dist/ai/markdown-renderer.d.ts",
      "import": "./dist/ai/markdown-renderer.js",
      "require": "./dist/ai/markdown-renderer.cjs"
    },
    "./ai/code-diff-viewer": {
      "types": "./dist/ai/code-diff-viewer.d.ts",
      "import": "./dist/ai/code-diff-viewer.js",
      "require": "./dist/ai/code-diff-viewer.cjs"
    },
    "./ai/interactive-graph": {
      "types": "./dist/ai/interactive-graph.d.ts",
      "import": "./dist/ai/interactive-graph.js",
      "require": "./dist/ai/interactive-graph.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./locales/*": "./dist/locales/*"
  },
  "size-limit": [
    {
      "name": "import { Button } — 単体利用の下限 (gzip)",
      "path": "dist/index.js",
      "import": "{ Button }",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "13 kB"
    },
    {
      "name": "小さな画面: Button/Input/Card/Stack/Text (gzip)",
      "path": "dist/index.js",
      "import": "{ Button, Input, Card, Stack, Text }",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "19 kB"
    },
    {
      "name": "フォーム画面: 入力7種 (gzip)",
      "path": "dist/index.js",
      "import": "{ Button, Input, Select, Checkbox, Switch, Textarea, Label }",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "23 kB"
    },
    {
      "name": "ルートバレル全部 — 最悪ケース (gzip)",
      "path": "dist/index.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "205 kB"
    },
    {
      "name": "wimui/form 全部 (gzip)",
      "path": "dist/form.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "95 kB"
    },
    {
      "name": "wimui/layout 全部 (gzip)",
      "path": "dist/layout.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "30 kB"
    },
    {
      "name": "wimui/data-display 全部 (gzip)",
      "path": "dist/data-display.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "76 kB"
    },
    {
      "name": "wimui/charts 全部 (gzip)",
      "path": "dist/charts.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "recharts"
      ],
      "gzip": true,
      "limit": "10 kB"
    },
    {
      "name": "wimui/ai 全部 (gzip・floating-ui 込み)",
      "path": "dist/ai.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "50 kB"
    },
    {
      "name": "UMD Bundle (gzip)",
      "path": "dist/wimui.umd.js",
      "gzip": true,
      "limit": "145 kB",
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "name": "styles.css — tokens + components (gzip)",
      "path": "dist/styles.css",
      "gzip": true,
      "limit": "78 kB",
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "name": "reset.css — reset/base (gzip)",
      "path": "dist/reset.css",
      "gzip": true,
      "limit": "4 kB",
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    },
    {
      "name": "Bundled third-party code (gzip)",
      "path": "dist/node_modules/**/*.js",
      "gzip": true,
      "limit": "5 kB",
      "disablePlugins": [
        "@size-limit/esbuild"
      ]
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "dev": "npm run generate:icons && npm run i18n:bundle && vite",
    "build": "npm run generate:icons && npm run i18n:bundle && npm run llms:build && vite build && vite build --mode umd && node scripts/build-style-entries.js && node scripts/fix-cjs-empty-css.js && node scripts/prune-dist-assets.js",
    "generate:icons": "node scripts/generate-icons.js",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:check": "node scripts/generate-missing-tests-report.cjs",
    "test:report": "npm run test:coverage && npm run test:check",
    "prestorybook": "npx kill-port 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "node scripts/cleanup-storybook.cjs && storybook build",
    "deploy": "npm run build-storybook && gh-pages -d storybook-static",
    "format": "prettier --write .",
    "lint": "eslint src stories --max-warnings=0",
    "lint:fix": "eslint src stories --fix --max-warnings=0",
    "stylelint:css": "stylelint \"{src,stories}/**/*.css\" --allow-empty-input",
    "stylelint:scss": "stylelint \"{src,stories}/**/*.scss\"",
    "stylelint": "npm run stylelint:css && npm run stylelint:scss",
    "stylelint:fix": "stylelint \"{src,stories}/**/*.{css,scss}\" --fix --allow-empty-input",
    "test:vrt": "playwright test vrt/vrt.spec.ts",
    "test:vrt:update": "playwright test vrt/vrt.spec.ts --update-snapshots",
    "vrt:report": "node scripts/vrt-color-shift-report.js",
    "test:vrt:report": "playwright show-report",
    "test:tap-target": "playwright test vrt/tap-target.spec.ts",
    "i18n:sync": "node scripts/sync-i18n.js",
    "i18n:bundle": "node scripts/generate-i18n-resources.js",
    "i18n:check": "node scripts/check-i18n.js",
    "i18n:props": "node scripts/backfill-prop-keys.js",
    "i18n:quality": "node scripts/check-i18n-quality.js",
    "i18n:check:components": "node scripts/check-i18n-components.js",
    "i18n:missing": "node scripts/find_missing_keys.js",
    "i18n:check:mdx": "node scripts/check-mdx-hardcoded.js",
    "i18n:check:ignore": "node scripts/check-i18n-ignore.js",
    "check:consistency": "node scripts/check_consistency.js",
    "check:hierarchy": "node scripts/check_hierarchy.js",
    "check:stories": "node scripts/check_stories_keys.js",
    "check:casing": "node scripts/check-git-casing.cjs",
    "check:links": "node scripts/check-mdx-links.js",
    "check:aschild": "node scripts/check-aschild.js && vitest run scripts/check-aschild-render.test.tsx",
    "check:api": "node scripts/check-public-api.js",
    "check:api:update": "node scripts/check-public-api.js --update",
    "check:prop-api": "node scripts/check-prop-api.js",
    "check:prop-api:update": "node scripts/check-prop-api.js --update",
    "check:hooks": "node scripts/check-root-hooks.js",
    "check:tokens": "node scripts/check-tokens.js",
    "check:tokens:update": "node scripts/check-tokens.js --update",
    "check:token-types": "node scripts/check-token-types.js",
    "check:scss-refs": "node scripts/check-scss-token-refs.js",
    "check:imports": "node scripts/check-imports.js",
    "check:vrt-orphans": "node scripts/check-vrt-orphans.js",
    "smoke": "npm run build && node scripts/smoke/run.mjs",
    "smoke:full": "npm run build && node scripts/smoke/run.mjs --full",
    "smoke:pnpm": "npm run build && node scripts/smoke/run.mjs --pm pnpm",
    "smoke:treeshake": "npm run build && node scripts/smoke/run.mjs --treeshake",
    "smoke:recipes": "npm run build && node scripts/smoke/run.mjs --recipes",
    "smoke:nobuild": "node scripts/smoke/run.mjs",
    "audit-mdx": "node scripts/audit-mdx.js",
    "audit:all": "node scripts/audit-all.js",
    "audit:lib": "node scripts/audit-all.js --lib",
    "audit:docs": "node scripts/audit-all.js --docs",
    "audit:hardcoded": "node scripts/check-hardcoded-values.js",
    "audit:stories-i18n": "node scripts/check-stories-hardcoded.js --all",
    "audit:i18n-ignore": "node scripts/check-i18n-ignore.js",
    "scaffold": "node scripts/scaffold-component.js",
    "llms:build": "node scripts/generate-llms.js",
    "check:doc-drift": "node scripts/check-doc-drift.js",
    "check:llms": "node scripts/generate-llms.js --check",
    "tokens:build": "node style-dictionary.config.js && node scripts/generate-intents.js && node scripts/generate-presets.js",
    "intents:build": "node scripts/generate-intents.js",
    "check:intents": "node scripts/generate-intents.js --check",
    "check:intents:scss": "node scripts/check-intents-scss.js",
    "check:mono": "node scripts/check-mono-family.js",
    "check:icons": "node scripts/check-icons.js",
    "check:icons:provenance": "node scripts/check-icon-provenance.js",
    "check:icons:mirror": "node scripts/check-icon-mirrors.js",
    "check:shrinkable": "node scripts/check-shrinkable-roots.js",
    "check:story-tokens": "node scripts/check-story-tokens.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:subtle-tokens": "node scripts/check-subtle-tokens.js",
    "check:contrast:scss": "node scripts/check-contrast-scss.js",
    "report:variant-distinctness": "node scripts/report-variant-distinctness.js",
    "check:prop-classes": "node scripts/check-prop-classes.js",
    "check:prop-vocabulary": "node scripts/check-prop-vocabulary.js",
    "check:color-values": "node scripts/check-color-values.js",
    "check:slop": "node scripts/check-slop.js",
    "judge:slop": "node scripts/judge-slop.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "version:packages": "changeset version && npm run llms:build",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "check:aliases": "node scripts/check-aliases.js",
    "check:improvements": "node scripts/check-improvements-status.js",
    "check:choice-matrix": "node scripts/check-choice-matrix.js",
    "check:intent-text": "node scripts/check-intent-text-color.js",
    "audit:src-i18n": "node scripts/check-src-hardcoded.js",
    "check:composition-rules": "node scripts/check-composition-rules.js",
    "check:readme": "node scripts/check-readme-claims.js",
    "check:examples": "node scripts/check-code-examples.js",
    "check:sandbox-pin": "node scripts/check-sandbox-pin.js",
    "check:external-assets": "node scripts/check-external-assets.js",
    "check:ci-paths": "node scripts/check-ci-paths.js",
    "check:class-references": "node scripts/check-class-references.js"
  },
