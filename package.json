  "lint-staged": {
    "{src,stories}/**/*.{ts,tsx}": [
      "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0 --cache",
      "node scripts/check-i18n-components.js",
      "node scripts/check-git-casing.cjs",
      "node scripts/generate-i18n-resources.js",
      "node scripts/stage-generated.js src/i18n/generated/resources.ts src/i18n/generated/keys.ts --"
    ],
    "stories/**/*.{ts,tsx}": [
      "node scripts/check-stories-hardcoded.js",
      "node scripts/check-i18n-ignore.js"
    ],
    "{stories,sandbox}/**/*.tsx": [
      "node scripts/check-slop.js",
      "node scripts/check-story-tokens.js",
      "node scripts/check-sandbox-pin.js"
    ],
    "{src,stories}/**/*.{css,scss}": [
      "stylelint --fix --max-warnings=0 --cache",
      "node scripts/check-mono-family.js",
      "node scripts/check-intent-text-color.js",
      "node scripts/check-contrast-scss.js",
      "node scripts/check-shrinkable-roots.js"
    ],
    "**/*.mdx": [
      "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0 --cache",
      "node scripts/check-mdx-hardcoded.js",
      "node scripts/check-i18n-components.js",
      "node scripts/check-mdx-links.js",
      "node scripts/audit-mdx.js",
      "node scripts/check-slop.js",
      "node scripts/check-story-tokens.js"
    ],
    "public/locales/**/*.json": [
      "node scripts/sync-i18n.js",
      "node scripts/stage-generated.js public/locales --",
      "node scripts/check-i18n.js",
      "node scripts/check-i18n-quality.js",
      "node scripts/generate-i18n-resources.js",
      "node scripts/stage-generated.js src/i18n/generated/resources.ts src/i18n/generated/keys.ts --"
    ],
    "src/icon/*.svg": [
      "npm run generate:icons",
      "node scripts/stage-generated.js src/icon/index.ts --"
    ],
    "tokens/intents.json": [
      "node scripts/generate-intents.js",
      "node scripts/stage-generated.js src/types/generated-intents.ts src/tokens/generated/_intents.scss --"
    ],
    "tokens/**/*.json": [
      "node scripts/check-contrast.js"
    ],
    "src/styles/_token-common.scss": [
      "node scripts/check-contrast.js"
    ],
    "src/components/**/*.module.scss": [
      "node scripts/check-prop-classes.js",
      "node scripts/generate-llms.js",
      "node scripts/stage-generated.js public/llms.txt public/llms-full.txt --"
    ],
    "src/components/**/*.{ts,tsx}": [
      "node scripts/generate-llms.js",
      "node scripts/stage-generated.js public/llms.txt public/llms-full.txt --"
    ],
    "public/locales/en/**/*.json": [
      "node scripts/generate-llms.js",
      "node scripts/stage-generated.js public/llms.txt public/llms-full.txt --"
    ],
    "{src/data/components.json,src/data/not-planned.json,scripts/slop-dictionary.json,scripts/generate-llms.js}": [
      "node scripts/check-aliases.js",
      "node scripts/generate-llms.js",
      "node scripts/stage-generated.js public/llms.txt public/llms-full.txt --"
    ],
    "IMPROVEMENTS.md": [
      "node scripts/check-improvements-status.js"
    ],
    "src/components/**/*.tsx": [
      "node scripts/check-src-hardcoded.js",
      "node scripts/check-prop-api.js"
    ],
    "{scripts/composition-rules.json,DESIGN.md}": [
      "node scripts/check-composition-rules.js"
    ],
    "{README.md,package.json}": [
      "node scripts/check-readme-claims.js"
    ],
    "{README.md,README.ja.md,public/llms.txt,public/llms-full.txt}": [
      "node scripts/check-code-examples.js"
    ]
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-slot": "1.3.3",
    "classnames": "^2.5.1",
    "react-is": "19.2.8"
  }
}
