{
  "name": "wimui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React component library with design tokens, dark mode, i18n (en/ja/pt-BR), and WAI-ARIA compliant accessibility. 200+ components documented in Storybook.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/icons.ts",
    "./dist/icons.js",
    "./dist/icons.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "require": "./dist/layout.cjs"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js",
      "require": "./dist/form.cjs"
    },
    "./rhf": {
      "types": "./dist/rhf.d.ts",
      "import": "./dist/rhf.js",
      "require": "./dist/rhf.cjs"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.cjs"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js",
      "require": "./dist/navigation.cjs"
    },
    "./data-display": {
      "types": "./dist/data-display.d.ts",
      "import": "./dist/data-display.js",
      "require": "./dist/data-display.cjs"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js",
      "require": "./dist/overlay.cjs"
    },
    "./typography": {
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js",
      "require": "./dist/typography.cjs"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./locales/*": "./dist/locales/*"
  },
  "size-limit": [
    {
      "name": "ESM library total (gzip)",
      "path": [
        "dist/**/*.js",
        "!dist/wimui.umd.js"
      ],
      "gzip": true,
      "limit": "380 kB"
    },
    {
      "name": "Bundled third-party code (gzip)",
      "path": "dist/node_modules/**/*.js",
      "gzip": true,
      "limit": "5 kB"
    },
    {
      "name": "form components (gzip)",
      "path": "dist/components/form/**/*.js",
      "gzip": true,
      "limit": "88 kB"
    },
    {
      "name": "charts components (gzip)",
      "path": "dist/components/charts/**/*.js",
      "gzip": true,
      "limit": "15 kB"
    },
    {
      "name": "UMD Bundle (gzip)",
      "path": "dist/wimui.umd.js",
      "gzip": true,
      "limit": "145 kB"
    },
    {
      "name": "styles.css — tokens + components (gzip)",
      "path": "dist/styles.css",
      "gzip": true,
      "limit": "78 kB"
    },
    {
      "name": "reset.css — reset/base (gzip)",
      "path": "dist/reset.css",
      "gzip": true,
      "limit": "4 kB"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "dev": "npm run generate:icons && npm run i18n:bundle && vite",
    "build": "npm run generate:icons && npm run i18n:bundle && vite build && vite build --mode umd && node scripts/build-style-entries.js && node scripts/fix-cjs-empty-css.js && node scripts/prune-dist-assets.js",
    "generate:icons": "node scripts/generate-icons.js",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:check": "node scripts/generate-missing-tests-report.cjs",
    "test:report": "npm run test:coverage && npm run test:check",
    "prestorybook": "npx kill-port 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "node scripts/cleanup-storybook.cjs && storybook build",
    "deploy": "npm run build-storybook && gh-pages -d storybook-static",
    "format": "prettier --write .",
    "lint": "eslint src stories --max-warnings=0",
    "lint:fix": "eslint src stories --fix --max-warnings=0",
    "stylelint:css": "stylelint \"{src,stories}/**/*.css\" --allow-empty-input",
    "stylelint:scss": "stylelint \"{src,stories}/**/*.scss\"",
    "stylelint": "npm run stylelint:css && npm run stylelint:scss",
    "stylelint:fix": "stylelint \"{src,stories}/**/*.{css,scss}\" --fix --allow-empty-input",
    "test:vrt": "playwright test",
    "test:vrt:update": "playwright test --update-snapshots",
    "test:vrt:report": "playwright show-report",
    "i18n:sync": "node scripts/sync-i18n.js",
    "i18n:bundle": "node scripts/generate-i18n-resources.js",
    "i18n:check": "node scripts/check-i18n.js",
    "i18n:props": "node scripts/backfill-prop-keys.js",
    "i18n:quality": "node scripts/check-i18n-quality.js",
    "i18n:check:components": "node scripts/check-i18n-components.js",
    "i18n:missing": "node scripts/find_missing_keys.js",
    "i18n:check:mdx": "node scripts/check-mdx-hardcoded.js",
    "i18n:check:ignore": "node scripts/check-i18n-ignore.js",
    "check:consistency": "node scripts/check_consistency.js",
    "check:hierarchy": "node scripts/check_hierarchy.js",
    "check:stories": "node scripts/check_stories_keys.js",
    "check:casing": "node scripts/check-git-casing.cjs",
    "check:links": "node scripts/check-mdx-links.js",
    "check:aschild": "node scripts/check-aschild.js",
    "check:api": "node scripts/check-public-api.js",
    "check:api:update": "node scripts/check-public-api.js --update",
    "check:hooks": "node scripts/check-root-hooks.js",
    "check:tokens": "node scripts/check-tokens.js",
    "check:tokens:update": "node scripts/check-tokens.js --update",
    "check:token-types": "node scripts/check-token-types.js",
    "check:scss-refs": "node scripts/check-scss-token-refs.js",
    "check:imports": "node scripts/check-imports.js",
    "audit-mdx": "node scripts/audit-mdx.js",
    "audit:all": "node scripts/audit-all.js",
    "audit:lib": "node scripts/audit-all.js --lib",
    "audit:docs": "node scripts/audit-all.js --docs",
    "audit:hardcoded": "node scripts/check-hardcoded-values.js",
    "audit:stories-i18n": "node scripts/check-stories-hardcoded.js --all",
    "audit:i18n-ignore": "node scripts/check-i18n-ignore.js",
    "scaffold": "node scripts/scaffold-component.js",
    "tokens:build": "node style-dictionary.config.js && node scripts/generate-intents.js",
    "intents:build": "node scripts/generate-intents.js",
    "check:intents": "node scripts/generate-intents.js --check",
    "check:intents:scss": "node scripts/check-intents-scss.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "components",
    "typescript",
    "accessibility",
    "a11y",
    "i18n",
    "storybook"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takeshisakuma/wimui.git"
  },
  "author": "takeshi sakuma",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/takeshisakuma/wimui/issues"
  },
  "homepage": "https://takeshisakuma.github.io/wimui/",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@google/genai": "2.11.0",
    "@hookform/resolvers": "5.4.0",
    "@playwright/test": "^1.59.0",
    "@size-limit/file": "^12.0.1",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-themes": "10.5.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "8.0.0",
    "@types/node": "26.1.1",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "19.2.0",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@xyflow/react": "12.11.2",
    "diff": "9.0.0",
    "dotenv": "^17.3.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.0",
    "gh-pages": "^6.3.0",
    "globals": "17.7.0",
    "husky": "^9.1.7",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "3.0.6",
    "jsdom": "^29.0.1",
    "lint-staged": "17.0.8",
    "music-metadata": "^11.14.0",
    "playwright": "^1.59.0",
    "prettier": "3.9.5",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react-hook-form": "7.81.0",
    "react-i18next": "17.0.10",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.98.0",
    "sharp": "0.35.3",
    "size-limit": "^12.0.1",
    "storybook": "10.5.0",
    "storybook-react-i18next": "10.1.2",
    "style-dictionary": "5.5.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.0.0",
    "svgo": "4.0.2",
    "typescript": "6.0.3",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-image-optimizer": "2.0.3",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.10",
    "web-features": "3.34.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@fullcalendar/core": ">=6.0.0",
    "@fullcalendar/daygrid": ">=6.0.0",
    "@fullcalendar/interaction": ">=6.0.0",
    "@fullcalendar/react": ">=6.0.0",
    "@fullcalendar/timegrid": ">=6.0.0",
    "@hookform/resolvers": "^5.1.0",
    "@xyflow/react": ">=12.0.0",
    "diff": ">=9.0.0",
    "music-metadata": ">=11.0.0",
    "qrcode.react": ">=4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.43.0",
    "react-markdown": ">=10.0.0",
    "recharts": ">=3.0.0",
    "remark-gfm": ">=4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "diff": {
      "optional": true
    },
    "music-metadata": {
      "optional": true
    },
    "qrcode.react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@fullcalendar/core": {
      "optional": true
    },
    "@fullcalendar/daygrid": {
      "optional": true
    },
    "@fullcalendar/interaction": {
      "optional": true
    },
    "@fullcalendar/react": {
      "optional": true
    },
    "@fullcalendar/timegrid": {
      "optional": true
    }
  },
  "lint-staged": {
    "{src,stories}/**/*.{ts,tsx}": [
      "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0 --cache",
      "node scripts/check-i18n-components.js",
      "node scripts/check-git-casing.cjs",
      "node scripts/generate-i18n-resources.js",
      "node scripts/stage-generated.js src/i18n/generated/resources.ts src/i18n/generated/keys.ts --"
    ],
    "stories/**/*.{ts,tsx}": [
      "node scripts/check-stories-hardcoded.js",
      "node scripts/check-i18n-ignore.js"
    ],
    "{src,stories}/**/*.{css,scss}": [
      "stylelint --fix --max-warnings=0 --cache"
    ],
    "**/*.mdx": [
      "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0 --cache",
      "node scripts/check-mdx-hardcoded.js",
      "node scripts/check-i18n-components.js",
      "node scripts/check-mdx-links.js",
      "node scripts/audit-mdx.js"
    ],
    "public/locales/**/*.json": [
      "node scripts/sync-i18n.js",
      "node scripts/stage-generated.js public/locales --",
      "node scripts/check-i18n.js",
      "node scripts/check-i18n-quality.js",
      "node scripts/generate-i18n-resources.js",
      "node scripts/stage-generated.js src/i18n/generated/resources.ts src/i18n/generated/keys.ts --"
    ],
    "src/icon/*.svg": [
      "npm run generate:icons",
      "node scripts/stage-generated.js src/icon/index.ts --"
    ],
    "tokens/intents.json": [
      "node scripts/generate-intents.js",
      "node scripts/stage-generated.js src/types/generated-intents.ts src/tokens/generated/_intents.scss --"
    ]
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-slot": "1.3.0",
    "classnames": "^2.5.1",
    "react-is": "19.2.7"
  }
}
