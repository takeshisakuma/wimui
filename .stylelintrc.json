{
  "ignoreFiles": ["src/tokens/generated/**"],
  "extends": [
    "stylelint-config-standard-scss",
    "stylelint-config-recess-order"
  ],
  "rules": {
    "no-duplicate-selectors": true,
    "selector-class-pattern": "^[a-z][a-zA-Z0-9-_]+$",
    "keyframes-name-pattern": "^[a-z][a-zA-Z0-9-_]+$",
    "color-function-alias-notation": null,
    "at-rule-no-unknown": null,
    "alpha-value-notation": "number",
    "scss/at-rule-no-unknown": true,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ],
    "media-feature-range-notation": null,
    "custom-property-pattern": "^_?([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
  },
  "overrides": [
    {
      "files": ["src/components/**/*.module.scss"],
      "rules": {
        "declaration-property-value-disallowed-list": [
          {
            "filter": ["/brightness/"],
            "/./": [
              "/color-mix\\(in srgb/",
              "/(?<![\\w-])(white|black|red|blue|green|yellow|orange|purple|pink|gray|grey|navy|teal|aqua|lime|maroon|olive|silver|fuchsia)(?![\\w-])/"
            ],
            "/^(margin|padding|gap|row-gap|column-gap|inset)/": [
              "/(?<!var\\([^)]*)(?<![\\d.-])([2-9]|\\d{2,})(\\.\\d+)?px/"
            ]
          }
        ]
      }
    }
  ]
}
